<Page x:Class="SIMS___projekat.Views.OdobravanjeZahtevaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Odobravanje Zahteva" Background="#f8f9fa">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zahtevi stanara za pristup stanovima" FontSize="24" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,20" Grid.Row="0"/>

        <DataGrid Name="dgZahtevi" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" BorderBrush="#dee2e6" BorderThickness="1" 
                  RowHeight="40" FontSize="14" HeadersVisibility="Column"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="JMBG Stanara" Binding="{Binding JmbgStanara}" Width="150"/>
                <DataGridTextColumn Header="Šifra zgrade" Binding="{Binding SifraZgrade}" Width="120"/>
                <DataGridTextColumn Header="Broj stana" Binding="{Binding BrojStana}" Width="100"/>
                <DataGridTextColumn Header="Trenutni Status" Binding="{Binding Status}" Width="130"/>

                <DataGridTemplateColumn Header="Akcije" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Odobri" Click="btnOdobri_Click" Width="80" Background="#198754" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="5" Margin="0,0,10,0"/>
                                <Button Content="Odbij" Click="btnOdbij_Click" Width="80" Background="#dc3545" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="5"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Nazad na Dashboard" Name="btnNazad" Click="btnNazad_Click" Grid.Row="2" 
                Width="200" Height="45" Margin="0,20,0,0" HorizontalAlignment="Left"
                Background="#6c757d" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Page>