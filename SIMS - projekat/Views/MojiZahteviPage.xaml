<Page x:Class="SIMS___projekat.Views.MojiZahteviPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Moji Zahtevi" Background="#f8f9fa">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Istorija mojih zahteva" FontSize="24" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,15" Grid.Row="0"/>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Filtriraj po statusu:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,10,0"/>
            <ComboBox Name="cmbFilter" Width="150" Padding="5" SelectionChanged="cmbFilter_SelectionChanged" SelectedIndex="0">
                <ComboBoxItem Content="Svi zahtevi"/>
                <ComboBoxItem Content="Na cekanju"/>
                <ComboBoxItem Content="Odobren"/>
                <ComboBoxItem Content="Odbijen"/>
            </ComboBox>
        </StackPanel>

        <DataGrid Name="dgMojiZahtevi" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" BorderBrush="#dee2e6" BorderThickness="1" 
                  RowHeight="40" FontSize="14" HeadersVisibility="Column"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Šifra zgrade" Binding="{Binding SifraZgrade}" Width="100"/>
                <DataGridTextColumn Header="Broj stana" Binding="{Binding BrojStana}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Razlog odbijanja" Binding="{Binding RazlogOdbijanja}" Width="*"/>

                <DataGridTemplateColumn Header="Akcije" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Povuci zahtev" Click="btnPovuci_Click" Width="100" Background="#dc3545" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Nazad na Dashboard" Name="btnNazad" Click="btnNazad_Click" Grid.Row="3" 
                Width="200" Height="45" Margin="0,20,0,0" HorizontalAlignment="Left"
                Background="#6c757d" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Page>