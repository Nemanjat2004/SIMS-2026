<Page x:Class="SIMS___projekat.Views.PrikazZgradaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Prikaz Zgrada" Background="#f8f9fa">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Prikaz svih zgrada u sistemu" FontSize="24" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,15" Grid.Row="0"/>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,15">
            <CheckBox Name="chkSortirajSpratovi" Content="Sortiraj prikaz po broju spratova (opadajuće)" 
                      Checked="chkSortirajSpratovi_Changed" Unchecked="chkSortirajSpratovi_Changed"
                      FontSize="14" FontWeight="Medium" Foreground="#495057" VerticalAlignment="Center" Cursor="Hand"/>
        </StackPanel>

        <DataGrid Name="dgZgrade" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" BorderBrush="#dee2e6" BorderThickness="1" 
                  RowHeight="35" FontSize="14" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Šifra zgrade" Binding="{Binding Sifra}" Width="*"/>
                <DataGridTextColumn Header="Adresa" Binding="{Binding AdresaUlicaIBroj}" Width="1.5*"/>
                <DataGridTextColumn Header="Naselje" Binding="{Binding Naselje}" Width="*"/>
                <DataGridTextColumn Header="Grad i država" Binding="{Binding LokacijaGradIDrzava}" Width="1.5*"/>
                <DataGridTextColumn Header="Broj spratova" Binding="{Binding BrojSpratova}" Width="110"/>

                <DataGridTemplateColumn Header="Akcije" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Spisak stanara" Click="btnSpisakStanara_Click" 
                                    Background="#0d6efd" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="5,2" Margin="5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Nazad na Dashboard" Name="btnNazad" Click="btnNazad_Click" Grid.Row="3" 
                Width="200" Height="45" Margin="0,20,0,0" HorizontalAlignment="Left"
                Background="#6c757d" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Page>