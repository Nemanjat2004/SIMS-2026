<Page x:Class="SIMS___projekat.Views.DodajUpravnikaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dodavanje Upravnika" Background="#f8f9fa">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
            <Border Background="White" Padding="30" CornerRadius="8" BorderBrush="#dee2e6" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#cccccc" Opacity="0.4"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Dodaj novog upravnika" FontSize="24" FontWeight="SemiBold" Foreground="#212529" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBlock Text="JMBG:" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtJmbg" Margin="0,5,0,12" Padding="8" FontSize="14" BorderBrush="#ced4da" BorderThickness="1"/>

                    <TextBlock Text="Ime:" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtIme" Margin="0,5,0,12" Padding="8" FontSize="14" BorderBrush="#ced4da" BorderThickness="1"/>

                    <TextBlock Text="Prezime:" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtPrezime" Margin="0,5,0,12" Padding="8" FontSize="14" BorderBrush="#ced4da" BorderThickness="1"/>

                    <TextBlock Text="Mobilni telefon:" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtTelefon" Margin="0,5,0,12" Padding="8" FontSize="14" BorderBrush="#ced4da" BorderThickness="1"/>

                    <TextBlock Text="Email adresa:" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtEmail" Margin="0,5,0,12" Padding="8" FontSize="14" BorderBrush="#ced4da" BorderThickness="1"/>

                    <TextBlock Text="Lozinka:" FontWeight="Medium" Foreground="#495057"/>
                    <PasswordBox Name="txtLozinka" Margin="0,5,0,25" Padding="8" FontSize="14" BorderBrush="#ced4da" BorderThickness="1"/>

                    <Button Content="Registruj Upravnika" Name="btnRegistruj" Click="btnRegistruj_Click" Padding="12" Background="#198754" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"/>

                    <Button Content="Odustani i vrati se nazad" Name="btnNazad" Click="btnNazad_Click" Padding="10" Background="#6c757d" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>