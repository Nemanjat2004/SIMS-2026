<Page x:Class="SIMS___projekat.Views.UnosStanaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Unos Stana" Background="#f8f9fa">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
            <Border Background="White" Padding="30" CornerRadius="8" BorderBrush="#dee2e6" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#cccccc" Opacity="0.4"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Unos novog stana" FontSize="24" FontWeight="SemiBold" Foreground="#212529" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBlock Text="Izaberite zgradu:" FontWeight="Medium" Foreground="#495057"/>
                    <ComboBox Name="cmbZgrade" Margin="0,5,0,15" Padding="5" FontSize="14" DisplayMemberPath="AdresaUlicaIBroj" SelectedValuePath="Sifra"/>

                    <TextBlock Text="Broj stana:" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtBrojStana" Margin="0,5,0,12" Padding="8" FontSize="14" BorderBrush="#ced4da"/>

                    <TextBlock Text="Opis stana (npr. kvadratura, struktura):" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtOpis" Margin="0,5,0,12" Padding="8" FontSize="14" BorderBrush="#ced4da"/>

                    <TextBlock Text="Broj soba:" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtBrojSoba" Margin="0,5,0,12" Padding="8" FontSize="14" BorderBrush="#ced4da"/>

                    <TextBlock Text="Maksimalan broj stanara:" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtMaxStanara" Margin="0,5,0,25" Padding="8" FontSize="14" BorderBrush="#ced4da"/>

                    <Button Content="Unesi stan" Name="btnUnesi" Click="btnUnesi_Click" Padding="12" Background="#ffc107" Foreground="#212529" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"/>
                    <Button Content="Odustani i vrati se nazad" Name="btnNazad" Click="btnNazad_Click" Padding="10" Background="#6c757d" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>