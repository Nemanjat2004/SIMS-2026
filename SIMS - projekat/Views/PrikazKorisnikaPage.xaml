<Page x:Class="SIMS___projekat.Views.PrikazKorisnikaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Prikaz Korisnika" Background="#f8f9fa">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Spisak svih korisnika u sistemu" FontSize="24" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,20" Grid.Row="0"/>

        <DataGrid Name="dgKorisnici" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" 
                  Background="White" BorderBrush="#dee2e6" BorderThickness="1" 
                  RowHeight="35" FontSize="14" HeadersVisibility="Column">
        </DataGrid>

        <Button Content="Nazad na Dashboard" Name="btnNazad" Click="btnNazad_Click" Grid.Row="2" 
                Width="200" Height="45" Margin="0,20,0,0" HorizontalAlignment="Left"
                Background="#6c757d" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Page>