<Page x:Class="SIMS___projekat.Views.PretragaZgradaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Pretraga Zgrada" Background="#f8f9fa">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Pretraga zgrada u sistemu" FontSize="24" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,20" Grid.Row="0"/>

        <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="8" BorderBrush="#dee2e6" BorderThickness="1" Margin="0,0,0,20">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Pretraži po:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#495057" Margin="0,0,10,0"/>

                <ComboBox Name="cmbKriterijum" Width="150" Margin="0,0,15,0" Padding="5" FontSize="14" SelectedIndex="0">
                    <ComboBoxItem Content="Adresa"/>
                    <ComboBoxItem Content="Naselje"/>
                    <ComboBoxItem Content="Broj spratova"/>
                    <ComboBoxItem Content="Broju stanova"/>
                </ComboBox>

                <TextBlock Text="Unesite upit:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#495057" Margin="0,0,10,0"/>
                <TextBox Name="txtUpit" Width="200" Padding="5" FontSize="14" Margin="0,0,15,0" BorderBrush="#ced4da" BorderThickness="1"/>

                <Button Content="Traži" Name="btnTrazi" Click="btnTrazi_Click" Width="100" Padding="5" Background="#0d6efd" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

                <Button Content="Poništi filtere" Name="btnPonisti" Click="btnPonisti_Click" Width="120" Padding="5" Background="#6c757d" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </WrapPanel>
        </Border>

        <DataGrid Name="dgRezultati" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" BorderBrush="#dee2e6" BorderThickness="1" 
                  RowHeight="35" FontSize="14" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Šifra zgrade" Binding="{Binding Sifra}" Width="*"/>
                <DataGridTextColumn Header="Adresa" Binding="{Binding AdresaUlicaIBroj}" Width="1.5*"/>
                <DataGridTextColumn Header="Naselje" Binding="{Binding Naselje}" Width="*"/>
                <DataGridTextColumn Header="Grad i država" Binding="{Binding LokacijaGradIDrzava}" Width="1.5*"/>
                <DataGridTextColumn Header="Broj spratova" Binding="{Binding BrojSpratova}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Nazad na Dashboard" Name="btnNazad" Click="btnNazad_Click" Grid.Row="3" 
                Width="200" Height="45" Margin="0,20,0,0" HorizontalAlignment="Left"
                Background="#6c757d" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Page>