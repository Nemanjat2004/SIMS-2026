<Page x:Class="SIMS___projekat.Views.DodajZgraduPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dodaj Zgradu" Background="#f8f9fa">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="600">
            <Border Background="White" Padding="30" CornerRadius="8" BorderBrush="#dee2e6" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#cccccc" Opacity="0.4"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Unos nove zgrade u sistem" FontSize="24" FontWeight="SemiBold" Foreground="#212529" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBlock Text="Šifra zgrade (jedinstveno):" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtSifra" Margin="0,5,0,12" Padding="8" FontSize="14" BorderBrush="#ced4da"/>

                    <TextBlock Text="Ulica i broj:" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtAdresa" Margin="0,5,0,12" Padding="8" FontSize="14" BorderBrush="#ced4da"/>

                    <TextBlock Text="Naselje:" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtNaselje" Margin="0,5,0,12" Padding="8" FontSize="14" BorderBrush="#ced4da"/>

                    <TextBlock Text="Grad i država:" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtLokacija" Margin="0,5,0,12" Padding="8" FontSize="14" BorderBrush="#ced4da"/>

                    <TextBlock Text="Broj spratova:" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtBrojSpratova" Margin="0,5,0,12" Padding="8" FontSize="14" BorderBrush="#ced4da"/>

                    <TextBlock Text="JMBG Upravnika (OBAVEZNO):" FontWeight="Medium" Foreground="#495057"/>
                    <TextBox Name="txtJmbgUpravnika" Margin="0,5,0,25" Padding="8" FontSize="14" BorderBrush="#ced4da"/>

                    <Button Content="Završi unos zgrade" Name="btnUnesiZgradu" Click="btnUnesiZgradu_Click" Padding="12" Background="#198754" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"/>
                    <Button Content="Odustani i vrati se nazad" Name="btnNazad" Click="btnNazad_Click" Padding="10" Background="#6c757d" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>