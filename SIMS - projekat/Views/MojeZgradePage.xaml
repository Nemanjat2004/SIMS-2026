<Page x:Class="SIMS___projekat.Views.MojeZgradePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Moje Zgrade" Background="#f8f9fa">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Upravljanje mojim zgradama" FontSize="24" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,20" Grid.Row="0"/>

        <DataGrid Name="dgMojeZgrade" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" BorderBrush="#dee2e6" BorderThickness="1" 
                  RowHeight="40" FontSize="14" HeadersVisibility="Column"
                  LoadingRowDetails="dgMojeZgrade_LoadingRowDetails"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Šifra" Binding="{Binding Sifra}" Width="80"/>
                <DataGridTextColumn Header="Adresa" Binding="{Binding AdresaUlicaIBroj}" Width="1.5*"/>
                <DataGridTextColumn Header="Naselje" Binding="{Binding Naselje}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Odobrena}" Width="80"/>

                <DataGridTemplateColumn Header="Akcije" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Stanovi" Click="btnPrikaziStanove_Click" Width="65" Background="#0d6efd" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="5" Margin="0,0,10,0"/>

                                <Button Content="Prihvati" Click="btnPrihvati_Click" Width="65" Background="#198754" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="5" Margin="0,0,10,0"/>
                                <Button Content="Odbij" Click="btnOdbij_Click" Width="65" Background="#dc3545" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="5"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="#e9ecef" Padding="15" Margin="10,5,10,10" CornerRadius="5" BorderBrush="#dee2e6" BorderThickness="1" HorizontalAlignment="Stretch">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Spisak stanova u ovoj zgradi:" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#495057"/>

                            <DataGrid Grid.Row="1" Name="dgStanoviDetalji" AutoGenerateColumns="False" IsReadOnly="True" 
                                      Background="White" BorderBrush="#ced4da" BorderThickness="1" HeadersVisibility="Column"
                                      HorizontalAlignment="Stretch">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Broj stana" Binding="{Binding BrojStana}" Width="120"/>
                                    <DataGridTextColumn Header="Broj soba" Binding="{Binding BrojSoba}" Width="120"/>
                                    <DataGridTextColumn Header="Max stanara" Binding="{Binding MaxBrojStanara}" Width="120"/>
                                    <DataGridTextColumn Header="Opis stana" Binding="{Binding Opis}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

        </DataGrid>

        <Button Content="Nazad na Dashboard" Name="btnNazad" Click="btnNazad_Click" Grid.Row="2" 
                Width="200" Height="45" Margin="0,20,0,0" HorizontalAlignment="Left"
                Background="#6c757d" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Page>