<Page x:Class="SIMS___projekat.Views.SlanjeZahtevaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Slanje Zahteva" Background="#f8f9fa">

    <Grid Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="450">
        <Border Background="White" Padding="30" CornerRadius="8" BorderBrush="#dee2e6" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#cccccc" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Zahtev za pristup stanu" FontSize="24" FontWeight="SemiBold" Foreground="#212529" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="1. Izaberite zgradu:" FontWeight="Medium" Foreground="#495057"/>
                <ComboBox Name="cmbZgrade" Margin="0,5,0,20" Padding="5" FontSize="14" 
                          DisplayMemberPath="AdresaUlicaIBroj" SelectedValuePath="Sifra"
                          SelectionChanged="cmbZgrade_SelectionChanged"/>

                <TextBlock Text="2. Izaberite stan:" FontWeight="Medium" Foreground="#495057"/>
                <ComboBox Name="cmbStanovi" Margin="0,5,0,25" Padding="5" FontSize="14" 
                          DisplayMemberPath="BrojStana" SelectedValuePath="BrojStana"/>

                <Button Content="Pošalji zahtev upravniku" Name="btnPosalji" Click="btnPosalji_Click" Padding="12" Background="#17a2b8" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"/>

                <Button Content="Odustani i vrati se nazad" Name="btnNazad" Click="btnNazad_Click" Padding="10" Background="#6c757d" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>